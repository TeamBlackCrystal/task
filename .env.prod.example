# docker-compose.prod.yml が要求する環境変数の一覧。
# 実際の値は Dokploy のアプリ設定「Environment」に貼る。値を書いたファイルはコミットしない。
#
# シークレット生成:
#   PERSONAL_TOKEN_SECRET / RECOVERY_CODE_SECRET / POSTGRES_PASSWORD
#     openssl rand -hex 32
#   TOTP_ENCRYPTION_KEY（UTF-8 でちょうど 32 バイト。hex 32 文字ではなく 32 文字）
#     openssl rand -hex 16
#   GITHUB_APP_WEBHOOK_SECRET / GITHUB_TOKEN_ENCRYPTION_KEY
#     openssl rand -hex 32
#   OAUTH_ENCRYPTION_KEY（32 文字以上。実際の鍵は HKDF で導出されるので文字列でよい）
#     openssl rand -base64 48
#   GITHUB_APP_PRIVATE_KEY（ダウンロードした .pem を 1 行にする）
#     awk 'BEGIN{ORS="\\n"} {print}' your-app.private-key.pem

# ghcr.io/<owner>/task-backend, task-frontend の <owner>（GitHub のユーザー / Organization 名）
GHCR_OWNER=yupix
# 公開したいバージョン。publish-images.yml が v* タグで push したもの（例: 0.1.0）。
# backend / frontend の両方に効く
IMAGE_TAG=0.1.0
# 片方だけ別のタグで動かしたいときに設定する（設定した側が IMAGE_TAG より優先される）。
# 片方のイメージがまだ公開されていない状態で、もう片方だけ先に出すとき用。
# 通常は両方コメントアウトのままでよい
#BACKEND_IMAGE_TAG=0.1.0
#FRONTEND_IMAGE_TAG=0.1.0

# 本番のフロントエンド URL。スキーム込み・末尾スラッシュなし
APP_ORIGIN=https://task.example.com

POSTGRES_PASSWORD=
PERSONAL_TOKEN_SECRET=
RECOVERY_CODE_SECRET=
TOTP_ENCRYPTION_KEY=

# 実在する SMTP サービス（Resend / SES / Mailgun など）。認証メールが送れないと登録が完了しない
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@task.example.com

# 初回セットアップ用。管理者が 1 人もいないときだけ、このメールのユーザーを管理者に昇格する
BOOTSTRAP_ADMIN_EMAIL=

# ログイン用の OAuth（任意）。空のままならサインイン画面に外部ログインのボタンが出ない。
# **GitHub App 連携（下）とは別物。** あちらはタスクとリポジトリを結ぶための App で、
# こちらはログイン手段。それぞれ別に OAuth App / Application を作って設定する。
#
# 1 つでも有効にするなら OAUTH_ENCRYPTION_KEY が必須（32 文字以上）。
# **一度決めたら変えない。** 変えると保存済みのリフレッシュトークンが復号できず、
# 連携済みのユーザーは OAuth をやり直すことになる。
OAUTH_ENCRYPTION_KEY=

# プロバイダ側に登録する Redirect URI は **/api を含める**:
#   {APP_ORIGIN}/api/v1/auth/oauth/{provider}/callback
# 例: https://task.example.com/api/v1/auth/oauth/github/callback
# backend は frontend の SSR サーバ（/api/* を転送）越しにしか公開されていないため。
# compose 側は APP_BASE_URL に ${APP_ORIGIN}/api を渡している

# GitHub（github.com）
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# GitLab（gitlab.com）
OAUTH_GITLAB_CLIENT_ID=
OAUTH_GITLAB_CLIENT_SECRET=

# GitLab セルフホスト。インスタンス URL は画面でユーザーが入力する（ここには持たない）
OAUTH_GITLAB_SELFHOSTED_CLIENT_ID=
OAUTH_GITLAB_SELFHOSTED_CLIENT_SECRET=

# Google
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# 汎用 OIDC。3 つすべて設定したときだけ有効になる
OAUTH_OIDC_ISSUER_URL=
OAUTH_OIDC_CLIENT_ID=
OAUTH_OIDC_CLIENT_SECRET=

# ログイン後の既定の遷移先（redirect_after を渡さなかったとき）。省略時は /dashboard
OAUTH_DEFAULT_REDIRECT_PATH=

# GitHub App 連携（任意）。GITHUB_APP_ID が空のままなら連携機能は無効のまま起動する。
# 有効にするときは 7 つすべて必要。GITHUB_APP_NAME は App の slug（インストール URL に使う）
GITHUB_APP_ID=
GITHUB_APP_NAME=
# App 設定ページの Client ID / Client secret。インストール時のユーザー認可に使う。
# App 側で「Request user authorization (OAuth) during installation」を有効にしておくこと
# （無効だと callback に code が付かず、連携が installation_authorization_required で止まる）
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# 改行を \n で表した 1 行で入れる（起動時に実際の改行へ展開される）
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# トークン暗号化用。32 文字以上
GITHUB_TOKEN_ENCRYPTION_KEY=
