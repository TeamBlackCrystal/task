# docker-compose.prod.yml が要求する環境変数の一覧。
# 実際の値は Dokploy のアプリ設定「Environment」に貼る。値を書いたファイルはコミットしない。
#
# シークレット生成:
#   PERSONAL_TOKEN_SECRET / RECOVERY_CODE_SECRET / POSTGRES_PASSWORD
#     openssl rand -hex 32
#   TOTP_ENCRYPTION_KEY（UTF-8 でちょうど 32 バイト。hex 32 文字ではなく 32 文字）
#     openssl rand -hex 16
#   GITHUB_APP_WEBHOOK_SECRET / GITHUB_TOKEN_ENCRYPTION_KEY
#     openssl rand -hex 32
#   GITHUB_APP_PRIVATE_KEY（ダウンロードした .pem を 1 行にする）
#     awk 'BEGIN{ORS="\\n"} {print}' your-app.private-key.pem

# ghcr.io/<owner>/task-backend, task-frontend の <owner>（GitHub のユーザー / Organization 名）
GHCR_OWNER=yupix
# 公開したいバージョン。publish-images.yml が v* タグで push したもの（例: 0.1.0）
IMAGE_TAG=0.1.0

# 本番のフロントエンド URL。スキーム込み・末尾スラッシュなし
APP_ORIGIN=https://task.example.com

POSTGRES_PASSWORD=
PERSONAL_TOKEN_SECRET=
RECOVERY_CODE_SECRET=
TOTP_ENCRYPTION_KEY=

# 実在する SMTP サービス（Resend / SES / Mailgun など）。認証メールが送れないと登録が完了しない
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@task.example.com

# 初回セットアップ用。管理者が 1 人もいないときだけ、このメールのユーザーを管理者に昇格する
BOOTSTRAP_ADMIN_EMAIL=

# GitHub App 連携（任意）。GITHUB_APP_ID が空のままなら連携機能は無効のまま起動する。
# 有効にするときは 7 つすべて必要。GITHUB_APP_NAME は App の slug（インストール URL に使う）
GITHUB_APP_ID=
GITHUB_APP_NAME=
# App 設定ページの Client ID / Client secret。インストール時のユーザー認可に使う。
# App 側で「Request user authorization (OAuth) during installation」を有効にしておくこと
# （無効だと callback に code が付かず、連携が installation_forbidden で止まる）
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# 改行を \n で表した 1 行で入れる（起動時に実際の改行へ展開される）
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# トークン暗号化用。32 文字以上
GITHUB_TOKEN_ENCRYPTION_KEY=
